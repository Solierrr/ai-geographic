# google-registry: unico dono das chaves de LLM (Gemini e Groq)
# Use diretamente os nomes oficiais expostos pelo Vault.
GOOGLE_REGISTRY_URL=http://localhost:8010
GOOGLE_REGISTRY_TIMEOUT_SECONDS=10
REGISTRY_CONSUMER_TOKEN=seu_token_de_consumidor_aqui

# Temporário enquanto Routes e Weather ainda não usam o google-registry.
GOOGLE_MAPS_API_KEY=sua_chave_do_google_maps_platform_aqui
DEFAULT_TIMEZONE=America/Sao_Paulo

# Conexão com o Banco de Dados MongoDB (checkpointer de curto prazo do LangGraph)
DB_MONGO_URI=mongodb://localhost:27017

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080

# Redis dos agentes no Upstash
UPSTASH_AGENTS_HOST=seu-banco-123456.upstash.io
UPSTASH_AGENTS_PORT=6379
UPSTASH_AGENTS_USERNAME=default

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Só pra rodar main.py localmente (JWT de usuário emitido pelo api-auth)
TEST_USER_TOKEN=seu_token_de_teste_aqui

# Validação do JWT de usuário (RS256/JWKS, emitido pelo api-auth).
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=solaria-auth

# mcp-database: tools consultadas pelos especialistas de exemplo (mesmo
# MCP_API_KEY do .env do mcp-database)
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=troque-por-uma-chave-forte-de-verdade

# Telemetria: desligada por padrão. Ver a seção Telemetria da documentação.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=ai-geographic
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
