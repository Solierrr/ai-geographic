# Chaves de API para os Modelos de Linguagem
GEMINI_API_KEY=sua_chave_do_gemini_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui
OPENAI_API_KEY=sua_chave_da_openai_aqui
LLM_MODEL_OPENAI=gpt-6-luna
LLM_PROVIDER_ORDER=gemini,groq,openai

# Conexão com o Banco de Dados MongoDB (checkpointer de curto prazo do LangGraph)
MONGODB_URI=mongodb://localhost:27017

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080

# Redis dos agentes no Upstash
UPSTASH_REDIS_HOST=seu-banco-123456.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_USERNAME=default
UPSTASH_REDIS_PASSWORD=sua_senha_aqui

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Só pra rodar main.py localmente (JWT de usuário via mock-idp ou api-auth)
TEST_USER_TOKEN=seu_token_de_teste_aqui

# Validação do JWT de usuário (RS256/JWKS, emitido pelo api-auth).
# Local/QA: aponte pro mock-idp (scripts/dev/mock_idp/app.py), na porta
# que você usar pra subir ele (ex.: uvicorn scripts.dev.mock_idp.app:app --port 8002).
JWT_JWKS_URL=http://localhost:8002/.well-known/jwks.json
JWT_ISSUER=solaria-auth

# MCP oficial do Google Maps (Grounding Lite). A chave precisa ter a API
# mapstools.googleapis.com habilitada.
MAPS_MCP_URL=https://mapstools.googleapis.com/mcp
GOOGLE_MAPS_API_KEY=troque-pela-chave-do-maps

# google-registry: viabilidade solar do telhado (Solar API do Google)
REGISTRY_URL=http://localhost:8004
REGISTRY_CONSUMER_TOKEN=token-de-consumidor-do-registry

# A2A: ai-assistant, para onde o copiloto delega a escolha de produtos
A2A_ASSISTANT_URL=http://localhost:8000

# Telemetria: desligada por padrão. Ver a seção Telemetria da documentação.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=ai-geographic
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
